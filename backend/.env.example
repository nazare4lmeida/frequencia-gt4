# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Autenticação
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASS=

# Conferência de GPS no check-in. Desligada por padrão: as aulas presenciais
# acontecem em 3 sedes, então não há um endereço único a validar.
# Só ligue se um dia voltar a existir sede única (e preencha as coordenadas).
EXIGIR_LOCALIZACAO=false

# Só usados se EXIGIR_LOCALIZACAO=true
CLASSROOM_LAT=
CLASSROOM_LNG=
CHECKIN_RADIUS_METERS=120

# true libera check-in/check-out em qualquer dia e horário.
# Use apenas em homologação. NUNCA em produção.
MODO_TESTE=false
